% ? unused URL ("https://linkinghub.elsevier.com/retrieve/pii/S0005273616300657")

@misc{Belagali2026,
  title = {The {{Nanoscale Impact}} of {{Cyclopropane Fatty Acids}} and {{Hopanoids}} on {{Alcohol Tolerance}} in {{Clostridium}} Acetobutylicum and {{Zymomonas}} Mobilis},
  author = {Belagali, Hrishikesh and Singh, Nitin Kumar and Vermaas, Josh V.},
  year = 2026,
  month = jun,
  doi = {10.26434/chemrxiv.15004463/v1},
  urldate = {2026-08-19},
  abstract = {Butanol and isobutanol are promising biofuel candidates produced natively by Clostridium acetobutylicum and Zymomonas mobilis. However, alcohol accumulation during fermentation disrupts membrane integrity and limits yields, increasing costs for industrial fermentation. These microbes have cyclopropane fatty acids (CFAs) and hopanoids in their native membranes in different ratios, which may contribute to observed alcohol tolerance differences in these organisms. To track the nanoscale origins of these alcohol phenotypes, we use all-atom molecular dynamics simulations to characterize the effects of CFAs on membrane structure and dynamics in both species under butanol and isobutanol stress at concentrations up to 2.5 mol\%. We simulate C. acetobutylicum membranes with varying CFA content and Z. mobilis membranes with varying CFA levels both with and without hopanoids. Key membrane properties including area per lipid, thickness, lipid order parameter, and lateral diffusion coefficient were analyzed across all conditions. In C. acetobutylicum, CFAs confer substantial protection against alcohol-induced perturbations. At high CFA content, changes in membrane properties remain minimal even at the highest alcohol concentrations. This protective effect is attributed to cyclopropane rings present in both acyl chains, which restrict conformational freedom in the membrane core. In contrast, Z. mobilis CFAs, which carry cyclopropane rings in only one tail, fail to stabilize the membrane on their own but produce a synergistic stabilization when paired with hopanoids, reducing alcohol permeability. These results establish that dual-ring CFAs provide significantly greater independent membrane stabilization than single-ring variants. We anticipate that future engineering efforts to produce robust biofuel-producing strains should thus prioritize dual-ring CFA pathways alongside increased active efflux to mitigate residual passive permeation.},
  abstract_draft = {A big all-atom MD deep dive into why cyclopropane fatty acids and hopanoids protect Clostridium and Zymomonas membranes from butanol/isobutanol stress, showing dual-ring CFAs alone pack a serious protective punch while single-ring CFAs need hopanoid backup!},
  langid = {english}
}
